{
  "manifest_version": 3,
  "name": "MANGA TRANSLATOR ULTIMATE — FREE LOCAL EDITION",
  "short_name": "Manga Translator",
  "version": "1.7.0",
  "key": "",
  "description": "Dịch truyện Anh và Nhật sang tiếng Việt bằng AI local.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Manga Translator Ultimate"
  },
  "options_page": "settings.html"
}
